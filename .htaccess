# ==============================================================================
# CONFIGURACIÓN APACHE / HTACCESS — PLATAFORMA "XV EXPERIENCE"
# ==============================================================================

# 1. Proteger archivos sensibles, bases de datos y configuraciones
<FilesMatch "^\.env|\.sql$|\.sqlite$|\.git|composer\.(json|lock)">
    Require all denied
</FilesMatch>

# 2. Opciones del Servidor
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Si se solicita un archivo estático real (imágenes, audio, css, js), servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Servir recursos estáticos desde public/assets directamente
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Si el archivo estático existe dentro de public/, servirlo desde allí
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Enrutar el resto de solicitudes a index.php (Front Controller)
    RewriteRule ^ index.php [QSA,L]
</IfModule>
