# Proteger archivos de configuración y base de datos
<FilesMatch "^\.env|\.sql$|\.git">
    Require all denied
</FilesMatch>

# Opciones generales
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
